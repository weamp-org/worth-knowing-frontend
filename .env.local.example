NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_
CLERK_SECRET_KEY=sk_
NEXT_PUBLIC_BACKEND_BASE_URL=http://localhost:3000/api/v1

# The canonical production origin of the frontend.
#
# Not an optional extra: `metadataBase`, the sitemap, every canonical URL and every
# Open Graph URL are built from it, and `src/lib/site.ts` has **no fallback for
# it**. A missing value means relative URLs where absolute ones are required, which
# Next raises at build time — deliberately, since a defaulted `localhost` here would
# build cleanly and ship localhost canonicals to production, failing invisibly.
#
# Set this to whatever the deployment actually serves. It must match the origin
# configured in Clerk's redirect URLs and in the backend's `FRONTEND_BASE_URL`, or
# CORS and sign-in will disagree with the canonical URLs.
NEXT_PUBLIC_SITE_URL=https://worthknowing.weamp.org